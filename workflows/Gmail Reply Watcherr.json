      "parameters": {
        "jsCode": "const emails = $input.all();\n\nconst replies = emails.filter(item => {\n  const subject = item.json.Subject || '';\n  const from = item.json.From || '';\n\n  // Must be a reply (starts with Re:)\n  const isReply = subject.toLowerCase().startsWith('re:');\n\n  // Must not be from yourself\n  const notFromSelf = !from.includes('ai.engrfaraharooj@gmail.com');\n\n  return isReply && notFromSelf;\n});\n\nreturn replies.map(item => ({ json: item.json }));"
      },
